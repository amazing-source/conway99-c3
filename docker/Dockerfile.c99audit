# c99audit: Python 3.12 + solvers used by every .py script of the C3 branch (versions = those of the runs of 2026-09-22/23)
FROM ghcr.io/astral-sh/uv:0.8.17-python3.12-bookworm-slim
RUN uv pip install --system sympy==1.14.0 numpy==2.5.3 python-sat==1.9.dev15 ortools==9.15.6755 networkx==3.7
WORKDIR /w
